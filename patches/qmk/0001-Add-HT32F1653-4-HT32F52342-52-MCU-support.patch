+#define HT32_PLL_OTDIV                      0
+#define HT32_AHB_PRESCALER                  2 // 144 MHz -> 72 MHz
+#define HT32_USB_PRESCALER                  3 // 144 MHz -> 48 MHz
+
+/*
+ * ST driver system settings.
+ */
+#define HT32_ST_USE_HCLK                    TRUE
+#define HT32_ST_IRQ_PRIORITY                8
+
