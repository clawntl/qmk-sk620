diff --git a/platforms/chibios/bootloaders/ht32_dfu.c b/platforms/chibios/bootloaders/ht32_dfu.c
new file mode 100644
index 00000000..76657abd
--- /dev/null
+++ b/platforms/chibios/bootloaders/ht32_dfu.c
@@ -0,0 +1,97 @@
